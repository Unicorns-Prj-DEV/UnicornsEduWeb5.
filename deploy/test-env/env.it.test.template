# deploy/test-env/env.it.test.template
#
# Mẫu .env cho test env IT trên `sunny`. KHÔNG điền tay — `remote.sh env` thay các
# placeholder __X__ bằng secret từ ~/uniedu-data/.env + openssl rand, ghi ra
# ~/UnicornsEdu/.env (chmod 600). Cấu trúc bám .env.production.example; chỉ khác
# những gì test env bắt buộc khác (URL, SMTP → Mailpit, Google OAuth giả, cổng).

# ── Hồ sơ môn (BẮT BUỘC) ───────────────────────────────────────────────────────
LMS_PROFILE=it

# ── Database + Storage (deploy/data-stack chạy ở ~/uniedu-data) ──────────────
DATA_NETWORK=uniedu-data-it
DATABASE_URL="postgresql://uniedu_it:__IT_DB_PASSWORD__@db:5432/uniedu_it"
DIRECT_URL="postgresql://uniedu_it:__IT_DB_PASSWORD__@db:5432/uniedu_it"
SUPABASE_URL="__PUBLIC_URL__"
SUPABASE_INTERNAL_URL="http://nginx"
SUPABASE_SERVICE_ROLE_KEY="__IT_STORAGE_SERVICE_KEY__"

# ── App URLs ─────────────────────────────────────────────────────────────────
PORT=4000
BACKEND_URL="__PUBLIC_URL__/api"
FRONTEND_URL="__PUBLIC_URL__"

# ── Reverse proxy ────────────────────────────────────────────────────────────
TRUST_PROXY=1
# Không set NODE_ENV — docker-compose.prod.yml ghim production (cookie Secure + SameSite).

# ── JWT Secrets (sinh riêng cho test env, không dùng lại của prod) ───────────
JWT_ACCESS_SECRET="__RAND_HEX__"
JWT_REFRESH_SECRET="__RAND_HEX__"
JWT_EMAIL_VERIFY_SECRET="__RAND_HEX__"
JWT_FORGOT_PASSWORD_SECRET="__RAND_HEX__"

# ── Email / SMTP → Mailpit (bắt mọi mail, không gửi ra ngoài) ────────────────
# Domain .test (RFC 2606) không bao giờ route được; Mailpit giữ hết thư.
ADMIN_EMAIL="admin@mock.uniedu.test"
SMTP_HOST="mailpit"
SMTP_PORT=1025
SMTP_USER="test"
SMTP_PASS="test"
SMTP_SECURE=false
MAIL_FROM="no-reply@mock.uniedu.test"

# ── Google OAuth (giả — API getOrThrow GOOGLE_CLIENT_ID lúc boot) ────────────
# Nút "Đăng nhập Google" sẽ lỗi ở bước Google; dùng đăng nhập mật khẩu.
GOOGLE_CLIENT_ID="test-env-disabled.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="test-env-disabled"
GOOGLE_CALLBACK_URL="__PUBLIC_URL__/api/auth/google/callback"
# Không có service account Google Calendar → đồng bộ lịch tắt.
GOOGLE_CALENDAR_ID=""

# ── Rate limiting (giống prod) ───────────────────────────────────────────────
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_DEFAULT_BLOCK_DURATION_MS=60000

# ── Caching (giống prod) ─────────────────────────────────────────────────────
DASHBOARD_CACHE_DEFAULT_TTL_SECONDS=60
AUTH_IDENTITY_CACHE_TTL_MS=5000
AUTH_IDENTITY_CACHE_MAX_ENTRIES=2000

# ── Docker Compose ───────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=unicorns-it-test
NGINX_PUBLISH=127.0.0.1:18080:80
MAILPIT_UI_PORT=18025

# ── SePay (để trống → nạp ví báo "chưa cấu hình", không gọi SePay thật) ──────
SEPAY_TOPUP_MODE="bank_transfer"
SEPAY_API_ACCESS_TOKEN=""
SEPAY_BANK_ACCOUNT_XID=""
SEPAY_TRANSFER_BANK_BIN="970422"
SEPAY_TRANSFER_ACCOUNT_NUMBER=""
SEPAY_TRANSFER_ACCOUNT_NAME=""
SEPAY_TRANSFER_BANK_NAME="MBBank"
SEPAY_TRANSFER_QR_TEMPLATE="compact2"
SEPAY_VIETQR_IMAGE_BASE_URL="https://img.vietqr.io/image"
# Secret riêng test env: cho phép tự ký HMAC để test webhook /api/webhook/sepay.
SEPAY_WEBHOOK_SECRET="__RAND_HEX__"
SEPAY_WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
SEPAY_WEBHOOK_ALLOW_LEGACY_SECRET_KEY=0
